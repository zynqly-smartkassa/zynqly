{
  "_description": "Zynqly Design Values — Cross-Platform Color Reference",
  "_note": "This file is the single source of truth for all brand colors. Keep in sync with app/globals.css.",
  "_flutter_usage": "Use Color(0xFFRRGGBB). Example: Color(0xFF7C3AED)",
  "_web_usage": "CSS custom properties are defined in globals.css. Use var(--z-violet-500) etc.",

  "violet": {
    "50":  { "hex": "#F5F3FF", "flutter": "0xFFF5F3FF", "description": "Lightest violet tint" },
    "100": { "hex": "#EDE9FE", "flutter": "0xFFEDE9FE", "description": "Badge backgrounds, subtle highlights" },
    "200": { "hex": "#DDD6FE", "flutter": "0xFFDDD6FE" },
    "300": { "hex": "#C4B5FD", "flutter": "0xFFC4B5FD" },
    "400": { "hex": "#A78BFA", "flutter": "0xFFA78BFA" },
    "500": { "hex": "#7C3AED", "flutter": "0xFF7C3AED", "description": "MAIN — main brand color, accents, key text" },
    "600": { "hex": "#6D28D9", "flutter": "0xFF6D28D9", "description": "Main hover / pressed state" },
    "700": { "hex": "#5B21B6", "flutter": "0xFF5B21B6" },
    "800": { "hex": "#4C1D95", "flutter": "0xFF4C1D95" },
    "900": { "hex": "#2E1065", "flutter": "0xFF2E1065" }
  },

  "neutral": {
    "50":  { "hex": "#F8F7FF", "flutter": "0xFFF8F7FF", "description": "Main page / screen background" },
    "100": { "hex": "#F0EFF8", "flutter": "0xFFF0EFF8", "description": "Card / surface on background" },
    "200": { "hex": "#E3E1F0", "flutter": "0xFFE3E1F0", "description": "Borders, dividers, input outlines" },
    "300": { "hex": "#CAC6DE", "flutter": "0xFFCAC6DE" },
    "400": { "hex": "#A8A3BE", "flutter": "0xFFA8A3BE", "description": "Muted / placeholder text" },
    "500": { "hex": "#847E9E", "flutter": "0xFF847E9E" },
    "600": { "hex": "#625D7E", "flutter": "0xFF625D7E", "description": "Secondary / supporting text" },
    "700": { "hex": "#484269", "flutter": "0xFF484269" },
    "800": { "hex": "#2E2947", "flutter": "0xFF2E2947" },
    "900": { "hex": "#1A1628", "flutter": "0xFF1A1628", "description": "Main text, headings" }
  },

  "status": {
    "success":      { "hex": "#22C55E", "flutter": "0xFF22C55E", "description": "Positive indicators, upward trends" },
    "successLight": { "hex": "#DCFCE7", "flutter": "0xFFDCFCE7", "description": "Success background chip" },
    "error":        { "hex": "#EF4444", "flutter": "0xFFEF4444", "description": "Validation errors" },
    "errorLight":   { "hex": "#FEE2E2", "flutter": "0xFFFEE2E2", "description": "Error background chip" }
  },

  "semantic": {
    "_note": "Aliases that map to the scales above — use these in components",
    "bgPage":           { "ref": "neutral.50",  "hex": "#F8F7FF", "flutter": "0xFFF8F7FF" },
    "bgSurface":        { "ref": "white",        "hex": "#FFFFFF", "flutter": "0xFFFFFFFF" },
    "bgCard":           { "ref": "neutral.100",  "hex": "#F0EFF8", "flutter": "0xFFF0EFF8" },
    "colorMain":        { "ref": "violet.500",   "hex": "#7C3AED", "flutter": "0xFF7C3AED" },
    "colorMainHover":   { "ref": "violet.600",   "hex": "#6D28D9", "flutter": "0xFF6D28D9" },
    "colorMainLight":   { "ref": "violet.100",   "hex": "#EDE9FE", "flutter": "0xFFEDE9FE" },
    "textMain":         { "ref": "neutral.900",  "hex": "#1A1628", "flutter": "0xFF1A1628" },
    "textSecondary":    { "ref": "neutral.600",  "hex": "#625D7E", "flutter": "0xFF625D7E" },
    "textMuted":        { "ref": "neutral.400",  "hex": "#A8A3BE", "flutter": "0xFFA8A3BE" },
    "border":           { "ref": "neutral.200",  "hex": "#E3E1F0", "flutter": "0xFFE3E1F0" }
  }
}

